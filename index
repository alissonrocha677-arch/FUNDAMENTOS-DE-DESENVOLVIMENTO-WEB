    };
    const pages = ["inicio", "treinos", "alimentacao", "progresso"];
    const labels = { inicio: "Visão geral", treinos: "Treinos", alimentacao: "Alimentação", progresso: "Meu progresso" };
    const toast = document.getElementById("toast");
    const guideDialog = document.getElementById("guideDialog");
    const workoutGuides = {
      strength: {
        title: "Musculação corpo todo A",
        steps: [
          { phase: "Preparação", icon: "🌿", title: "Aquecimento na esteira ou bicicleta", duration: "5 minutos", description: "Use esteira ou bicicleta ergométrica em ritmo leve, suficiente para aquecer sem ficar ofegante. Antes de começar, peça à equipe da academia para mostrar os ajustes dos aparelhos.", cues: ["Ajuste velocidade e resistência para um nível confortável.", "Faça uma série bem leve de familiarização no primeiro aparelho."], tip: "Não precisa correr nem pedalar forte: o aquecimento deve preparar, não cansar." },
          { phase: "Exercício 1", icon: "🦵", title: "Leg press", duration: "2 séries de 8–12 repetições · descanse 60–90 s", description: "Ajuste o banco para que as costas fiquem apoiadas. Coloque os pés na plataforma na largura do quadril. Destrave conforme a instrução do aparelho, desça a plataforma devagar até onde seja confortável e empurre sem travar os joelhos.", cues: ["Mantenha quadril e costas apoiados no encosto.", "Use uma carga leve; joelhos acompanham a direção dos pés."], tip: "Peça à equipe para ensinar como ajustar o banco, travas e carga. Se sentir dor no joelho ou nas costas, pare." },
          { phase: "Exercício 2", icon: "💪", title: "Chest press (máquina de peito)", duration: "2 séries de 8–12 repetições · descanse 60–90 s", description: "Ajuste o banco para que as alças fiquem aproximadamente na altura do meio do peito. Segure as alças, empurre à frente sem travar os cotovelos e retorne lentamente.", cues: ["Mantenha as costas apoiadas e os ombros relaxados.", "Controle a volta; não deixe os pesos baterem."], tip: "Comece com o menor peso que permita fazer as repetições com controle e sem prender a respiração." },
          { phase: "Exercício 3", icon: "↩️", title: "Remada sentada na máquina", duration: "2 séries de 8–12 repetições · descanse 60–90 s", description: "Sente-se com os pés apoiados e coluna confortável. Puxe as alças em direção ao tronco, levando os cotovelos para trás, e estenda os braços devagar sem arredondar as costas.", cues: ["Mantenha o peito aberto e o tronco estável.", "Evite balançar o corpo para puxar a carga."], tip: "Peça ajuda para identificar a regulagem correta e manter a coluna em posição confortável." },
          { phase: "Exercício 4", icon: "🦿", title: "Mesa flexora", duration: "2 séries de 8–12 repetições · descanse 60–90 s", description: "Ajuste o rolo acolchoado próximo aos tornozelos e alinhe o joelho ao eixo indicado no aparelho. Flexione as pernas devagar e retorne controlando o peso.", cues: ["Mantenha o quadril apoiado no banco.", "Use amplitude confortável e sem impulsos."], tip: "A posição do rolo varia por aparelho: confira o ajuste com a equipe antes de iniciar." },
          { phase: "Exercício 5", icon: "⬇️", title: "Puxada frontal", duration: "2 séries de 8–12 repetições · descanse 60–90 s", description: "Sente-se com as coxas apoiadas sob o suporte. Segure a barra um pouco além da largura dos ombros e puxe à frente, em direção à parte alta do peito. Retorne com controle.", cues: ["Puxe a barra pela frente, nunca atrás da nuca.", "Mantenha o tronco estável e os ombros longe das orelhas."], tip: "Use pouca carga no início e peça a um profissional para demonstrar a pegada e os ajustes." },
          { phase: "Finalização", icon: "🌬️", title: "Desacelere e registre como se sentiu", duration: "3 minutos", description: "Caminhe devagar ou pedale leve. Respire normalmente e observe se sentiu algum desconforto.", cues: ["Guarde os pesos e deixe o aparelho organizado.", "Anote cargas que conseguiu controlar para conversar com o profissional que acompanha você."], tip: "Não aumente a carga se a técnica ainda não estiver confortável. A execução vem antes do peso." }
        ]
      },
      gymLower: {
        title: "Treino B · Pernas e glúteos",
        steps: [
          { phase: "Preparação", icon: "🌿", title: "Aqueça na bicicleta", duration: "5 minutos", description: "Pedale leve e ajuste o banco para que o joelho fique ligeiramente flexionado quando o pedal estiver mais baixo.", cues: ["Mantenha um ritmo que permita conversar.", "Peça à equipe para conferir o ajuste do banco."], tip: "Use resistência baixa para aquecer, sem fadigar as pernas." },
          { phase: "Exercício 1", icon: "🦵", title: "Leg press", duration: "2 séries de 8–12 repetições · descanse 60–90 s", description: "Apoie costas e quadril no banco. Posicione os pés na largura do quadril, desça a plataforma até uma amplitude confortável e empurre sem travar os joelhos.", cues: ["Joelhos acompanham a direção dos pés.", "Não deixe o quadril sair do encosto."], tip: "Peça demonstração das travas e comece com carga leve." },
          { phase: "Exercício 2", icon: "🪑", title: "Cadeira extensora", duration: "2 séries de 8–12 repetições · descanse 60–90 s", description: "Ajuste o encosto e posicione o rolo acolchoado acima dos tornozelos. Estenda os joelhos sem dar impulso e volte lentamente.", cues: ["Alinhe o joelho ao eixo do aparelho.", "Use movimento confortável, sem chutar o peso."], tip: "Os ajustes variam entre aparelhos; peça ajuda para posicionar o rolo corretamente." },
          { phase: "Exercício 3", icon: "🦿", title: "Mesa flexora", duration: "2 séries de 8–12 repetições · descanse 60–90 s", description: "Alinhe os joelhos ao eixo da máquina e posicione o rolo próximo aos tornozelos. Flexione as pernas de forma controlada e retorne devagar.", cues: ["Mantenha o quadril apoiado.", "Não use balanço para mover a carga."], tip: "Reduza a amplitude ou a carga se sentir desconforto." },
          { phase: "Exercício 4", icon: "🍑", title: "Abdução de quadril na máquina", duration: "2 séries de 10–12 repetições · descanse 60 s", description: "Sente-se com as costas apoiadas e ajuste as almofadas para a parte externa das pernas. Afaste os joelhos suavemente e retorne devagar.", cues: ["Mantenha o tronco estável.", "Faça movimentos controlados sem bater os pesos."], tip: "Ajuste a abertura inicial para uma posição confortável e peça orientação à equipe." },
          { phase: "Finalização", icon: "🌬️", title: "Desacelere", duration: "3 minutos", description: "Caminhe devagar e espere a respiração voltar ao normal. Alongue suavemente apenas se for confortável.", cues: ["Beba água se estiver com sede.", "Observe como joelhos e quadris se sentem."], tip: "Interrompa se surgir dor, tontura ou mal-estar." }
        ]
      },
      gymUpper: {
        title: "Treino C · Peito e costas",
        steps: [
          { phase: "Preparação", icon: "🌿", title: "Aqueça e ajuste os aparelhos", duration: "5 minutos", description: "Faça alguns minutos de bicicleta ou caminhada leve. Peça à equipe para mostrar como regular banco, assento e carga antes de cada aparelho.", cues: ["Movimente suavemente ombros e braços.", "Comece com uma série leve para conhecer o movimento."], tip: "Nunca altere pinos ou ajustes de um aparelho sem entender como ele funciona." },
          { phase: "Exercício 1", icon: "💪", title: "Chest press", duration: "2 séries de 8–12 repetições · descanse 60–90 s", description: "Ajuste as alças à altura do peito. Empurre à frente com controle e retorne lentamente, mantendo as costas apoiadas.", cues: ["Evite travar os cotovelos.", "Mantenha ombros relaxados e respiração fluida."], tip: "Escolha uma carga leve que permita executar todas as repetições com boa técnica." },
          { phase: "Exercício 2", icon: "↩️", title: "Remada sentada", duration: "2 séries de 8–12 repetições · descanse 60–90 s", description: "Com os pés apoiados, puxe as alças em direção ao tronco e leve os cotovelos para trás. Retorne sem arredondar as costas.", cues: ["Mantenha o peito aberto e o tronco estável.", "Não balance para mover o peso."], tip: "Peça ajuda para ajustar a distância do assento e escolher a pegada." },
          { phase: "Exercício 3", icon: "⬇️", title: "Puxada frontal", duration: "2 séries de 8–12 repetições · descanse 60–90 s", description: "Apoie as coxas sob o suporte. Puxe a barra pela frente em direção à parte alta do peito e deixe-a subir devagar.", cues: ["Não puxe a barra atrás da nuca.", "Evite inclinar o tronco para ganhar impulso."], tip: "Se os ombros incomodarem, pare e peça orientação para ajustar o movimento." },
          { phase: "Exercício 4", icon: "🪽", title: "Voador inverso na máquina", duration: "2 séries de 8–12 repetições · descanse 60 s", description: "Ajuste o banco e as alças conforme demonstração da equipe. Com os braços à frente, abra-os suavemente para os lados e retorne com controle.", cues: ["Use carga baixa e mantenha os ombros relaxados.", "Não force a abertura além da sua mobilidade."], tip: "A posição muda conforme o aparelho; peça uma demonstração antes da primeira série." },
          { phase: "Finalização", icon: "🌬️", title: "Desacelere", duration: "3 minutos", description: "Caminhe leve, respire com calma e perceba como braços, ombros e costas estão se sentindo.", cues: ["Guarde os acessórios usados.", "Anote dúvidas para conversar com a equipe da academia."], tip: "Se sentir dor ou mal-estar, interrompa o treino e peça ajuda." }
        ]
      },
      mobility: {
        title: "Mobilidade e alongamento",
        steps: [
          { phase: "Preparação", icon: "🌿", title: "Encontre uma posição confortável", duration: "1 minuto", description: "Fique em pé ou sente-se com apoio. Faça algumas respirações tranquilas e solte os ombros.", cues: ["Escolha um espaço estável e sem obstáculos.", "Alongamento deve trazer sensação suave, nunca dor."], tip: "Faça tudo sentado se ficar em pé não for confortável." },
          { phase: "Movimento 1", icon: "🙆", title: "Solte os ombros", duration: "8 círculos para cada lado", description: "Eleve suavemente os ombros, leve-os para trás e para baixo, desenhando círculos lentos.", cues: ["Mantenha o pescoço relaxado.", "Faça círculos pequenos e respire normalmente."], tip: "Diminua o tamanho dos círculos se sentir tensão." },
          { phase: "Movimento 2", icon: "🐈", title: "Mobilize a coluna", duration: "6 repetições", description: "Em quatro apoios ou sentado, arredonde suavemente as costas e depois volte a uma posição neutra.", cues: ["Acompanhe o movimento com a respiração.", "Não force o pescoço nem vá além do confortável."], tip: "A versão sentada funciona bem: apoie as mãos nas coxas e movimente a coluna devagar." },
          { phase: "Movimento 3", icon: "🦵", title: "Alongue a parte de trás da perna", duration: "20 segundos por lado", description: "Sente-se na beirada de uma cadeira firme, estenda uma perna com o calcanhar no chão e incline o tronco só um pouco.", cues: ["Mantenha as costas confortáveis e o pé relaxado.", "Troque de lado sem balançar."], tip: "Uma leve sensação de alongamento é suficiente. Não puxe o pé." },
          { phase: "Finalização", icon: "🌬️", title: "Respire e perceba", duration: "1 minuto", description: "Volte a uma posição confortável e faça algumas respirações lentas. Observe como seu corpo está agora.", cues: ["Relaxe a mandíbula e os ombros.", "Levante-se devagar, caso estivesse sentado."], tip: "Movimento gentil também é treino. Obrigado por reservar esse tempo para você." }
        ]
      },
      cardio: {
        title: "Energia em movimento",
        steps: [
          { phase: "Preparação", icon: "🌿", title: "Comece devagar", duration: "3 minutos", description: "Marche suavemente no lugar ou caminhe pelo espaço para aquecer. Mantenha uma intensidade em que ainda consiga conversar.", cues: ["Use calçados e um espaço seguros.", "Apoie-se numa cadeira firme se precisar de equilíbrio."], tip: "Sem impacto: mantenha sempre um pé no chão." },
          { phase: "Movimento 1", icon: "🚶", title: "Marcha confortável", duration: "3 minutos", description: "Alterne os pés elevando-os pouco do chão. Balance os braços naturalmente ou segure num apoio estável.", cues: ["Mantenha um ritmo confortável.", "Respire de forma contínua; não prenda o ar."], tip: "Adaptação: faça a marcha sentado, elevando um pé de cada vez." },
          { phase: "Movimento 2", icon: "↔️", title: "Passos para o lado", duration: "2 minutos", description: "Dê um passo curto para um lado e junte os pés. Repita para o outro lado, sem cruzar as pernas.", cues: ["Mantenha os passos curtos e controlados.", "Fique perto de uma parede ou cadeira se quiser apoio."], tip: "Adaptação: toque um pé para o lado sem transferir todo o peso." },
          { phase: "Movimento 3", icon: "🦶", title: "Toque alternado à frente", duration: "2 minutos", description: "Toque um pé à frente e volte ao centro. Alterne os lados num ritmo tranquilo.", cues: ["Mantenha o tronco ereto sem rigidez.", "Reduza o alcance se perder o equilíbrio."], tip: "Adaptação: faça sentado, estendendo um pé de cada vez." },
          { phase: "Finalização", icon: "🌬️", title: "Diminua o ritmo", duration: "3 minutos", description: "Caminhe lentamente e deixe a respiração voltar ao normal. Termine com alguns movimentos leves dos ombros.", cues: ["Não pare de repente se estiver ofegante.", "Descanse e beba água se sentir sede."], tip: "Se a intensidade ficou alta demais, na próxima vez faça pausas mais longas." }
        ]
      }
    };
    const guideAliases = {
      "Musculação corpo todo A": "strength",
      "Treino B · Pernas e glúteos": "gymLower",
      "Treino C · Peito e costas": "gymUpper",
      "Mobilidade e alongamento": "mobility",
      "Alongue e respire": "mobility",
      "Energia em movimento": "cardio"
    };
    let activeGuide = null;
    let activeGuideStep = 0;
    let toastTimer;

    function saveState() {
      try {
        localStorage.setItem(storageKey, JSON.stringify(state));
      } catch (error) {
        console.warn("Não foi possível salvar seus dados neste navegador.", error);
      }
    }

    function notify(message) {
      toast.textContent = message;
      toast.classList.add("show");
      window.clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => toast.classList.remove("show"), 2600);
    }

    function showPage(page) {
      if (!pages.includes(page)) return;
      document.querySelectorAll(".page").forEach((section) => section.classList.toggle("active", section.id === `page-${page}`));
      document.querySelectorAll(".nav-button").forEach((button) => button.classList.toggle("active", button.dataset.page === page));
      document.getElementById("crumb").textContent = labels[page];
      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    function renderWater() {
      document.getElementById("waterCount").textContent = state.water.toFixed(2).replace(".", ",");
      document.getElementById("waterProgress").style.width = `${Math.min(state.water / 2 * 100, 100)}%`;
    }

    function renderHabits() {
      const inputs = document.querySelectorAll("[data-habit]");
      let completed = 0;
      inputs.forEach((input) => {
        input.checked = Boolean(state.habits[input.dataset.habit]);
        input.closest(".habit").classList.toggle("done", input.checked);
        if (input.checked) completed += 1;
      });
      document.getElementById("habitSummary").textContent = `${completed} de 3 hábitos concluídos`;
    }

    function renderGuideStep() {
      const step = activeGuide.steps[activeGuideStep];
      document.getElementById("guideTitle").textContent = activeGuide.title;
      document.getElementById("guidePhase").textContent = `${step.phase} · ${step.duration}`;
      document.getElementById("guideCounter").textContent = `Passo ${activeGuideStep + 1} de ${activeGuide.steps.length}`;
      document.getElementById("guideProgress").style.width = `${((activeGuideStep + 1) / activeGuide.steps.length) * 100}%`;
      document.getElementById("guideIcon").textContent = step.icon;
      document.getElementById("guideStepTitle").textContent = step.title;
      document.getElementById("guideDescription").textContent = step.description;
      document.getElementById("guideCues").innerHTML = step.cues.map((cue) => `<div class="guide-cue"><b>✓</b><span>${cue}</span></div>`).join("");
      document.getElementById("guideTip").innerHTML = `<strong>Dica para adaptar:</strong> ${step.tip}`;
      document.getElementById("previousStep").disabled = activeGuideStep === 0;
      document.getElementById("nextStep").textContent = activeGuideStep === activeGuide.steps.length - 1 ? "Concluir treino" : "Próximo passo";
    }

    function openWorkoutGuide(workoutName) {
      const guideKey = guideAliases[workoutName];
      if (!guideKey || !workoutGuides[guideKey]) {
        notify("Não encontramos o guia deste treino.");
        return;
      }
      activeGuide = workoutGuides[guideKey];
      activeGuideStep = 0;
      renderGuideStep();
      guideDialog.showModal();
    }

    async function checkAIStatus() {
      const status = document.getElementById("aiStatus");
      try {
        const response = await fetch("/api/status");
        if (!response.ok) throw new Error("Status indisponível.");
        const data = await response.json();
        status.classList.toggle("ready", data.configured);
        status.textContent = data.configured
          ? "Chave da IA configurada no servidor. As preferências são enviadas somente para criar esta sugestão."
          : "Falta configurar OPENAI_API_KEY no servidor local para ativar a IA.";
      } catch {
        status.classList.remove("ready");
        status.textContent = "Servidor local da IA não detectado. Inicie o app com node server.mjs.";
      }
    }

    document.querySelectorAll(".nav-button").forEach((button) => button.addEventListener("click", () => showPage(button.dataset.page)));
    document.querySelectorAll("[data-go]").forEach((button) => button.addEventListener("click", () => showPage(button.dataset.go)));
    document.querySelectorAll(".start-workout").forEach((button) => button.addEventListener("click", () => openWorkoutGuide(button.dataset.name)));
    document.getElementById("closeGuide").addEventListener("click", () => guideDialog.close());
    document.getElementById("previousStep").addEventListener("click", () => {
      if (activeGuideStep > 0) {
        activeGuideStep -= 1;
        renderGuideStep();
      }
    });
    document.getElementById("nextStep").addEventListener("click", () => {
      if (activeGuideStep < activeGuide.steps.length - 1) {
        activeGuideStep += 1;
        renderGuideStep();
        return;
      }
      guideDialog.close();
      notify(`Treino "${activeGuide.title}" concluído. Parabéns por se movimentar!`);
    });
    document.getElementById("addWater").addEventListener("click", () => {
      state.water = Math.round((state.water + 0.25) * 100) / 100;
      renderWater();
      saveState();
      notify("Hidratação atualizada. Bom trabalho!");
    });
    document.querySelectorAll("[data-habit]").forEach((input) => input.addEventListener("change", () => {
      state.habits[input.dataset.habit] = input.checked;
      renderHabits();
      saveState();
    }));
    document.getElementById("coachButton").addEventListener("click", () => showPage("progresso"));
    checkAIStatus();
    document.getElementById("aiPlanForm").addEventListener("submit", async (event) => {
      event.preventDefault();
      const button = document.getElementById("aiSubmit");
      const result = document.getElementById("aiResult");
      const originalLabel = button.textContent.trim();
      button.disabled = true;
      button.textContent = "Preparando sua sugestão...";
      result.classList.remove("error");
      result.classList.add("visible");
      result.textContent = "A IA está preparando uma sugestão de treino...";
      try {
        const response = await fetch("/api/coach", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            goal: document.getElementById("aiGoal").value,
            experience: document.getElementById("aiExperience").value,
            daysPerWeek: Number(document.getElementById("aiDays").value)
          })
        });
        const data = await response.json();
        if (!response.ok) {
          const messages = {
            AI_NOT_CONFIGURED: "A chave da OpenAI ainda não foi configurada no servidor. Defina OPENAI_API_KEY e reinicie o app.",
            RATE_LIMITED: "Muitas solicitações em pouco tempo. Aguarde alguns minutos e tente novamente.",
            INVALID_INPUT: "Confira as opções selecionadas e tente novamente.",
            AI_UNAVAILABLE: "A IA está indisponível neste momento. Tente novamente mais tarde."
          };
          throw new Error(messages[data.error] || data.message || "Não foi possível gerar a sugestão.");
        }
        if (typeof data.plan !== "string" || !data.plan.trim()) {
          throw new Error("A IA retornou uma resposta vazia. Tente novamente.");
        }
        result.textContent = data.plan.trim();
      } catch (error) {
        result.classList.add("error");
        result.textContent = error instanceof TypeError
          ? "Não foi possível conectar ao servidor local. Inicie o app com `node server.mjs` e tente novamente."
          : error.message;
      } finally {
        button.disabled = false;
        button.textContent = originalLabel;
      }
    });
    document.getElementById("todayDate").textContent = new Intl.DateTimeFormat("pt-BR", { weekday: "short", day: "numeric", month: "short" }).format(new Date());
    renderWater();
    renderHabits();
  </script>
</body>
</html>
