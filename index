<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#f6f7f2">
  <title>Viva — seu espaço de saúde</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --ink: #1d2924;
      --muted: #828b85;
      --green: #2f7657;
      --green-dark: #245c43;
      --green-soft: #e5eee7;
      --paper: #f6f7f2;
      --card: #fff;
      --line: #e9ece6;
      --orange: #e8a66b;
      --shadow: 0 12px 34px rgba(30, 47, 37, .045);
    }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--paper); color: var(--ink); font-family: "DM Sans", sans-serif; font-size: 14px; }
    button { color: inherit; font: inherit; cursor: pointer; }
    .app { display: flex; min-height: 100vh; }
    .sidebar { width: 248px; flex: 0 0 248px; min-height: 100vh; background: #fff; border-right: 1px solid var(--line); padding: 28px 18px 22px; display: flex; flex-direction: column; }
    .brand { display: flex; align-items: center; gap: 11px; padding: 0 12px; margin-bottom: 48px; }
    .brand-mark { width: 36px; height: 36px; border-radius: 12px; display: grid; place-items: center; color: white; background: var(--green); }
    .brand-mark svg { width: 21px; height: 21px; }
    .brand-name { font: 800 20px Manrope, sans-serif; letter-spacing: -1px; }
    .brand-name span { color: var(--green); }
    .nav-label { padding: 0 13px; margin: 0 0 12px; color: #a0a7a1; font-size: 10px; font-weight: 700; letter-spacing: 1.15px; text-transform: uppercase; }
    .nav { display: grid; gap: 5px; }
    .nav-button { border: 0; display: flex; align-items: center; gap: 13px; width: 100%; padding: 12px 13px; border-radius: 11px; background: transparent; color: #77817a; text-align: left; font-weight: 600; transition: .2s; }
    .nav-button:hover { background: #f5f7f3; color: var(--ink); }
    .nav-button.active { color: var(--green-dark); background: var(--green-soft); }
    .nav-button svg { width: 18px; height: 18px; stroke-width: 1.8; }
    .sidebar-bottom { margin-top: auto; }
    .coach-card { padding: 16px; border-radius: 15px; color: white; background: var(--green-dark); overflow: hidden; position: relative; }
    .coach-card:after { content: ""; width: 105px; height: 105px; border: 1px solid rgba(255,255,255,.15); position: absolute; border-radius: 50%; right: -44px; bottom: -53px; box-shadow: 0 0 0 14px rgba(255,255,255,.04), 0 0 0 28px rgba(255,255,255,.035); }
    .coach-card p { margin: 0 0 7px; color: #c3d9ca; font-size: 11px; }
    .coach-card strong { display: block; max-width: 150px; font: 700 16px/1.35 Manrope, sans-serif; }
    .coach-card button { margin-top: 15px; padding: 8px 11px; border: 0; border-radius: 8px; background: #fff; color: var(--green-dark); font-size: 11px; font-weight: 700; }
    .profile { display: flex; align-items: center; gap: 10px; padding: 19px 8px 0; margin-top: 20px; border-top: 1px solid var(--line); }
    .avatar { display: grid; place-items: center; width: 35px; height: 35px; border-radius: 50%; color: #55725d; background: #e8ede7; font-weight: 700; }
    .profile strong { display: block; font-size: 12px; }
    .profile span { color: var(--muted); font-size: 10px; }
    .main { flex: 1; min-width: 0; max-width: 1600px; margin: 0 auto; padding: 0 42px 44px; }
    .topbar { height: 84px; border-bottom: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between; }
    .breadcrumb { color: var(--muted); font-size: 12px; }
    .breadcrumb b { color: var(--ink); font-weight: 600; }
    .top-actions { display: flex; align-items: center; gap: 18px; }
    .date-chip { color: #737e76; font-size: 12px; }
    .icon-button { position: relative; width: 36px; height: 36px; display: grid; place-items: center; border: 1px solid var(--line); border-radius: 11px; background: white; }
    .icon-button svg { width: 17px; height: 17px; }
    .icon-button:after { content: ""; position: absolute; top: 8px; right: 8px; width: 6px; height: 6px; border-radius: 50%; background: #e38f63; border: 1px solid #fff; }
    .page { display: none; padding-top: 30px; animation: appear .24s ease; }
    .page.active { display: block; }
    @keyframes appear { from { opacity: .45; transform: translateY(4px); } to { opacity: 1; transform: none; } }
    .welcome { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 24px; }
    .eyebrow { color: var(--green); font-size: 10px; font-weight: 700; letter-spacing: 1.15px; text-transform: uppercase; }
    h1 { margin: 7px 0 0; font: 700 27px Manrope, sans-serif; letter-spacing: -.9px; }
    .welcome p { margin: 7px 0 0; color: var(--muted); font-size: 12px; }
    .date-button { display: flex; align-items: center; gap: 8px; padding: 9px 12px; border: 1px solid var(--line); border-radius: 10px; background: #fff; color: #657069; font-size: 11px; }
    .date-button svg { width: 15px; height: 15px; }
    .hero { display: grid; grid-template-columns: 1.18fr .82fr; min-height: 228px; overflow: hidden; border-radius: 19px; background: #e9efe7; margin-bottom: 22px; }
    .hero-copy { padding: 29px 32px; position: relative; z-index: 1; }
    .hero-tag { display: inline-flex; align-items: center; gap: 6px; color: var(--green-dark); padding: 6px 9px; border: 1px solid rgba(47,118,87,.17); background: rgba(255,255,255,.48); border-radius: 20px; font-size: 10px; font-weight: 600; }
    .hero-tag svg { width: 13px; height: 13px; }
    .hero h2 { max-width: 360px; margin: 15px 0 8px; font: 700 25px/1.24 Manrope, sans-serif; letter-spacing: -.7px; }
    .hero p { color: #68766d; margin: 0; font-size: 12px; }
    .primary-button { display: inline-flex; align-items: center; gap: 9px; margin-top: 18px; padding: 11px 15px; border: 0; border-radius: 9px; color: white; background: var(--green); font-size: 11px; font-weight: 700; transition: .2s; }
    .primary-button:hover { background: var(--green-dark); transform: translateY(-1px); }
    .primary-button svg { width: 15px; height: 15px; }
    .hero-art { position: relative; min-height: 228px; overflow: hidden; background: linear-gradient(110deg, #e9efe7 0%, rgba(233,239,231,.28) 25%, transparent 50%), url("https://images.unsplash.com/photo-1517836357463-d25dfeac3438?auto=format&fit=crop&w=1000&q=85") center 48% / cover; }
    .hero-art:after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, #e9efe7 0%, transparent 38%), linear-gradient(0deg, rgba(28,55,39,.2), transparent 40%); }
    .stat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 24px; }
    .stat-card, .panel, .workout-card { border: 1px solid var(--line); border-radius: 15px; background: var(--card); box-shadow: var(--shadow); }
    .stat-card { min-height: 111px; padding: 15px 16px; }
    .stat-top { display: flex; justify-content: space-between; align-items: center; color: var(--muted); font-size: 10px; font-weight: 500; }
    .stat-icon { width: 27px; height: 27px; display: grid; place-items: center; border-radius: 8px; color: var(--green); background: #eef4ee; }
    .stat-icon svg { width: 15px; height: 15px; }
    .stat-value { display: flex; align-items: baseline; gap: 5px; margin-top: 9px; font: 700 22px Manrope, sans-serif; letter-spacing: -.6px; }
    .stat-value small { color: #879088; font: 500 10px "DM Sans", sans-serif; letter-spacing: 0; }
    .stat-foot { color: #929b94; margin-top: 2px; font-size: 9px; }
    .stat-foot em { color: var(--green); font-style: normal; font-weight: 700; }
    .content-grid { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(270px, .85fr); gap: 18px; }
    .panel { padding: 19px; }
    .panel-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 17px; }
    .panel-heading h3 { margin: 0; font: 700 14px Manrope, sans-serif; letter-spacing: -.2px; }
    .panel-heading p { color: var(--muted); margin: 5px 0 0; font-size: 10px; }
    .text-button { padding: 5px 0; border: 0; background: transparent; color: var(--green); font-size: 10px; font-weight: 700; }
    .workout-list { display: grid; gap: 11px; }
    .workout-card { display: flex; align-items: center; gap: 13px; padding: 10px; border-radius: 12px; box-shadow: none; }
    .workout-thumb { width: 57px; height: 57px; flex: 0 0 57px; border-radius: 9px; background-color: #e8eee8; background-size: cover; background-position: center; }
    .gym-fullbody { background-image: url("https://images.unsplash.com/photo-1534438327276-14e5300c3a48?auto=format&fit=crop&w=900&q=85"); }
    .gym-legs { background-image: url("https://images.unsplash.com/photo-1517963628607-235ccdd5476c?auto=format&fit=crop&w=900&q=85"); }
    .gym-upper { background-image: url("https://images.unsplash.com/photo-1517836357463-d25dfeac3438?auto=format&fit=crop&w=900&q=85"); }
    .mobility-image { background-image: url("https://images.unsplash.com/photo-1518611012118-696072aa579a?auto=format&fit=crop&w=900&q=85"); }
    .cardio-image { background-image: url("https://images.unsplash.com/photo-1552674605-db6ffd4facb5?auto=format&fit=crop&w=900&q=85"); }
    .workout-info { flex: 1; min-width: 0; }
    .workout-info strong { display: block; font-size: 11px; }
    .workout-info span { display: block; margin-top: 5px; color: var(--muted); font-size: 9px; }
    .workout-meta { display: flex; gap: 9px; margin-top: 7px; color: #7d8981; font-size: 9px; }
    .workout-meta span { display: flex; align-items: center; gap: 4px; }
    .workout-meta svg { width: 12px; height: 12px; }
    .round-play { flex: 0 0 32px; width: 32px; height: 32px; display: grid; place-items: center; border: 0; border-radius: 50%; color: white; background: var(--green); }
    .round-play svg { width: 14px; height: 14px; }
    .side-stack { display: grid; align-content: start; gap: 16px; }
    .water-card { padding: 18px; border-radius: 15px; background: #eaf1eb; }
    .water-top { display: flex; align-items: center; justify-content: space-between; }
    .water-top h3 { margin: 0; font: 700 13px Manrope, sans-serif; }
    .water-top .stat-icon { color: #5482a0; background: #dce9ec; }
    .water-count { margin-top: 13px; font: 700 23px Manrope, sans-serif; letter-spacing: -.7px; }
    .water-count small { color: #7e8d84; font: 500 10px "DM Sans", sans-serif; letter-spacing: 0; }
    .progress-track { height: 6px; overflow: hidden; margin-top: 10px; border-radius: 8px; background: rgba(72,113,83,.13); }
    .progress-fill { width: 55%; height: 100%; border-radius: inherit; background: var(--green); transition: width .25s ease; }
    .water-bottom { display: flex; justify-content: space-between; align-items: center; margin-top: 12px; color: #7b887e; font-size: 9px; }
    .add-water { display: flex; align-items: center; gap: 5px; padding: 7px 9px; border: 1px solid rgba(47,118,87,.16); border-radius: 8px; color: var(--green-dark); background: rgba(255,255,255,.7); font-size: 9px; font-weight: 700; }
    .add-water svg { width: 12px; height: 12px; }
    .habit-list { display: grid; gap: 11px; }
    .habit { display: flex; align-items: center; gap: 10px; color: #59645d; font-size: 10px; }
    .habit input { appearance: none; width: 16px; height: 16px; margin: 0; border: 1.5px solid #cbd4cc; border-radius: 5px; background: white; cursor: pointer; }
    .habit input:checked { border-color: var(--green); background: var(--green); }
    .habit input:checked:after { content: "✓"; display: block; color: white; text-align: center; line-height: 14px; font-size: 10px; }
    .habit.done span { color: #98a099; text-decoration: line-through; }
    .habits-summary { padding-top: 11px; margin-top: 13px; border-top: 1px solid var(--line); color: var(--muted); font-size: 9px; }
    .page-intro { margin: 4px 0 23px; }
    .page-intro h1 { margin-top: 0; }
    .page-intro p { margin: 7px 0 0; color: var(--muted); font-size: 12px; }
    .program-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; }
    .program-card { overflow: hidden; border: 1px solid var(--line); border-radius: 15px; background: white; }
    .program-image { height: 145px; background-color: #e8eee8; background-position: center; background-size: cover; }
    .program-body { padding: 16px; }
    .program-tag { color: var(--green); font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: .7px; }
    .program-body h3 { margin: 7px 0 6px; font: 700 15px Manrope, sans-serif; }
    .program-body p { min-height: 32px; margin: 0; color: var(--muted); font-size: 10px; line-height: 1.6; }
    .program-footer { display: flex; align-items: center; justify-content: space-between; margin-top: 13px; color: #768178; font-size: 9px; }
    .program-footer button { display: grid; place-items: center; width: 29px; height: 29px; border: 0; border-radius: 50%; color: white; background: var(--green); }
    .program-footer svg { width: 13px; height: 13px; }
    .ai-coach { margin-bottom: 17px; padding: 21px; border: 1px solid #dfe9df; border-radius: 16px; background: linear-gradient(130deg, #f1f6ef, #fff 72%); }
    .ai-heading { display: flex; align-items: flex-start; gap: 12px; margin-bottom: 16px; }
    .ai-mark { width: 37px; height: 37px; display: grid; place-items: center; flex: 0 0 37px; border-radius: 11px; color: #fff; background: var(--green); font-size: 18px; }
    .ai-heading h2 { margin: 1px 0 4px; font: 700 15px Manrope, sans-serif; }
    .ai-heading p { margin: 0; color: var(--muted); font-size: 10px; line-height: 1.5; }
    .ai-fields { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 11px; }
    .ai-field label { display: block; margin-bottom: 6px; color: #667269; font-size: 10px; font-weight: 700; }
    .ai-field select { width: 100%; min-height: 39px; padding: 0 10px; border: 1px solid #e3e8e1; border-radius: 9px; outline: none; color: var(--ink); background: white; font: 500 11px "DM Sans", sans-serif; }
    .ai-field select:focus { border-color: #77a18a; box-shadow: 0 0 0 3px rgba(47,118,87,.1); }
    .ai-submit { margin-top: 14px; }
    .ai-submit:disabled { opacity: .65; cursor: wait; transform: none; }
    .ai-result { display: none; margin-top: 16px; padding: 15px; border: 1px solid var(--line); border-radius: 11px; background: white; color: #455249; font-size: 11px; line-height: 1.75; white-space: pre-wrap; overflow-wrap: anywhere; }
    .ai-result.visible { display: block; }
    .ai-result.error { border-color: #edd4ca; background: #fff9f6; color: #8d4936; }
    .ai-status { margin: 11px 0 0; color: #8a6e3d; font-size: 9px; line-height: 1.5; }
    .ai-status.ready { color: var(--green); }
    .ai-note { margin: 12px 0 0; color: #8a938c; font-size: 9px; line-height: 1.6; }
    .nutrition-layout { display: grid; grid-template-columns: 1.1fr .9fr; gap: 16px; }
    .meal-row { display: flex; align-items: center; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--line); }
    .meal-row:last-child { border-bottom: 0; }
    .meal-icon { width: 38px; height: 38px; display: grid; place-items: center; flex: 0 0 38px; border-radius: 11px; background: #f2f4ec; font-size: 17px; }
    .meal-row strong { display: block; font-size: 11px; }
    .meal-row span { display: block; margin-top: 4px; color: var(--muted); font-size: 9px; }
    .meal-kcal { margin-left: auto; color: #738078; white-space: nowrap; font-size: 10px; }
    .calorie-number { margin: 9px 0 3px; font: 700 28px Manrope, sans-serif; }
    .calorie-number small { color: var(--muted); font: 500 10px "DM Sans", sans-serif; }
    .macro { margin-top: 17px; }
    .macro-label { display: flex; justify-content: space-between; color: #68746c; font-size: 10px; }
    .macro .progress-track { height: 5px; margin-top: 7px; background: #eef0ec; }
    .macro .progress-fill { background: #d49a62; }
    .macro:nth-of-type(3) .progress-fill { background: #779bbb; }
    .macro:nth-of-type(4) .progress-fill { background: #83a779; }
    .chart-panel { margin-top: 17px; }
    .chart-wrap { height: 235px; margin-top: 10px; }
    .chart-wrap svg { width: 100%; height: 100%; overflow: visible; }
    .chart-grid { stroke: #edf0ea; stroke-width: 1; }
    .chart-line { fill: none; stroke: var(--green); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
    .chart-area { fill: url(#chartFill); }
    .chart-dot { fill: white; stroke: var(--green); stroke-width: 2.5; }
    .chart-label { fill: #929a94; font: 10px "DM Sans", sans-serif; }
    .goal-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; }
    .goal-card { padding: 19px; border: 1px solid var(--line); border-radius: 15px; background: white; }
    .goal-card span { color: var(--muted); font-size: 10px; }
    .goal-card strong { display: block; margin-top: 9px; font: 700 22px Manrope, sans-serif; }
    .goal-card small { color: var(--green); font-size: 10px; }
    .disclaimer { margin-top: 20px; color: #8a938c; font-size: 10px; line-height: 1.6; }
    .guide-dialog { width: min(520px, calc(100% - 28px)); max-height: min(760px, calc(100% - 32px)); padding: 0; overflow: auto; border: 1px solid var(--line); border-radius: 20px; color: var(--ink); background: var(--paper); box-shadow: 0 24px 80px rgba(19,35,25,.25); }
    .guide-dialog::backdrop { background: rgba(22,33,26,.55); backdrop-filter: blur(4px); }
    .guide-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; padding: 22px 24px 16px; border-bottom: 1px solid var(--line); background: white; }
    .guide-head h2 { margin: 5px 0 0; font: 700 19px Manrope, sans-serif; letter-spacing: -.5px; }
    .guide-close { width: 34px; height: 34px; flex: 0 0 34px; display: grid; place-items: center; border: 1px solid var(--line); border-radius: 10px; background: white; font-size: 20px; line-height: 1; }
    .guide-close:hover { background: var(--paper); }
    .guide-content { padding: 22px 24px 24px; }
    .guide-status { display: flex; justify-content: space-between; color: var(--muted); font-size: 10px; }
    .guide-progress { height: 5px; margin: 10px 0 22px; border-radius: 8px; background: #e7ebe5; overflow: hidden; }
    .guide-progress div { width: 0; height: 100%; border-radius: inherit; background: var(--green); transition: width .2s ease; }
    .guide-step-icon { display: grid; place-items: center; width: 47px; height: 47px; border-radius: 14px; background: var(--green-soft); color: var(--green); font-size: 22px; }
    .guide-content h3 { margin: 14px 0 7px; font: 700 20px Manrope, sans-serif; letter-spacing: -.5px; }
    .guide-description { color: #68746c; font-size: 12px; line-height: 1.7; }
    .guide-cues { display: grid; gap: 9px; margin-top: 17px; }
    .guide-cue { display: flex; gap: 9px; align-items: flex-start; padding: 11px 12px; border-radius: 10px; background: white; color: #5e6a62; font-size: 11px; line-height: 1.5; }
    .guide-cue b { color: var(--green); }
    .guide-tip { padding: 12px 13px; margin-top: 13px; border-radius: 10px; background: #f0eee6; color: #73694f; font-size: 10px; line-height: 1.6; }
    .guide-tip strong { color: #675a3f; }
    .guide-safety { margin: 14px 0 0; color: #858f87; font-size: 9px; line-height: 1.6; }
    .guide-actions { display: flex; justify-content: space-between; gap: 12px; margin-top: 21px; }
    .secondary-button { padding: 10px 14px; border: 1px solid var(--line); border-radius: 9px; color: #657069; background: white; font-size: 11px; font-weight: 700; }
    .secondary-button:disabled { opacity: .45; cursor: not-allowed; }
    .toast { position: fixed; bottom: 24px; left: 50%; z-index: 5; transform: translate(-50%, 16px); opacity: 0; padding: 12px 17px; border-radius: 11px; color: white; background: #233b2e; box-shadow: 0 8px 24px rgba(0,0,0,.15); font-size: 11px; pointer-events: none; transition: .25s; }
    .toast.show { transform: translate(-50%, 0); opacity: 1; }
    @media (max-width: 1050px) {
      .sidebar { width: 210px; flex-basis: 210px; }
      .main { padding-right: 26px; padding-left: 26px; }
      .content-grid { grid-template-columns: 1.2fr .8fr; }
      .stat-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 760px) {
      .app { display: block; padding-bottom: 68px; }
      .sidebar { position: fixed; z-index: 4; left: 0; right: 0; bottom: 0; top: auto; width: 100%; min-height: 0; height: 64px; padding: 5px 10px; border-top: 1px solid var(--line); border-right: 0; }
      .brand, .nav-label, .sidebar-bottom { display: none; }
      .nav { height: 100%; grid-template-columns: repeat(4, 1fr); gap: 2px; }
      .nav-button { justify-content: center; flex-direction: column; gap: 3px; padding: 5px 2px; border-radius: 9px; font-size: 9px; }
      .nav-button svg { width: 18px; height: 18px; }
      .main { padding: 0 16px 30px; }
      .topbar { height: 58px; }
      .date-chip { display: none; }
      .page { padding-top: 21px; }
      .welcome { align-items: flex-start; }
      h1 { font-size: 23px; }
      .date-button { padding: 8px; font-size: 0; }
      .date-button svg { width: 17px; height: 17px; }
      .hero { grid-template-columns: 1fr; min-height: auto; }
      .hero-copy { padding: 23px; }
      .hero h2 { max-width: 280px; font-size: 22px; }
      .hero-art { min-height: 135px; background-position: center 42%; }
      .hero-art:after { background: linear-gradient(0deg, rgba(28,55,39,.14), transparent 75%); }
      .content-grid, .nutrition-layout { grid-template-columns: 1fr; }
      .ai-fields { grid-template-columns: 1fr; }
      .ai-coach { padding: 17px; }
      .program-grid { grid-template-columns: 1fr; }
      .program-image { height: 170px; }
      .goal-grid { grid-template-columns: 1fr; gap: 10px; }
